# Application
APP_NAME=DevPulse
APP_ENV=development
DEBUG=false

# API
API_HOST=127.0.0.1
API_PORT=8000

# Database (replace with your local or containerized PostgreSQL URL)
DATABASE_URL=postgresql+asyncpg://devpulse:devpulse@localhost:5432/devpulse

# Redis (used later for caching and background jobs)
REDIS_URL=redis://localhost:6379/0

# GitHub integration (create credentials only when implementing GitHub auth)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# AI provider (configure only when AI features are implemented)
OPENAI_API_KEY=
